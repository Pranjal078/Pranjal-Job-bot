# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.

# ── Telegram ──────────────────────────────────────────────────────────────────
# Create a bot via https://t.me/botfather → get token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal chat ID — get it by messaging https://t.me/userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Gmail API (for LinkedIn email parsing) ────────────────────────────────────
# Path to your OAuth2 credentials JSON downloaded from Google Cloud Console
# See README.md → "Gmail API Setup" for full instructions
GMAIL_CREDENTIALS_PATH=credentials.json

# Path where the generated OAuth2 token will be stored after first login
GMAIL_TOKEN_PATH=token.json

# ── Email / SMTP (fallback if Telegram not configured) ────────────────────────
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_TO=your_email@gmail.com
